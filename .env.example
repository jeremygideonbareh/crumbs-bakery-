# Supabase
VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Admin Panel — change this password in production
VITE_ADMIN_PASSWORD=your-admin-password

# Supabase Personal Access Token (used for API-based DB/webhook management)
SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# Resend email secrets are set server-side via: supabase secrets set RESEND_API_KEY=... OWNER_EMAIL=... FROM_EMAIL=...
