# Supabase
VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Admin Panel — change this password in production
VITE_ADMIN_PASSWORD=your-admin-password

# Supabase Personal Access Token (used for API-based DB/webhook management)
SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# Meta WhatsApp Cloud API (for pre-order notifications)
VITE_WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
VITE_WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
VITE_LILY_WHATSAPP_NUMBER=your-whatsapp-number
